# Copy this file to .env.local and fill in the values.
# See README.md for how to create a Spotify Developer app.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000

# Encrypts the Spotify refresh token at rest — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

DATABASE_URL="file:./dev.db"
