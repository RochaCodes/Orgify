// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String   @id @default(cuid())
  spotifyId          String   @unique
  displayName        String?
  email              String?
  image              String?
  /// Token mirror for future background jobs. The request path never reads these:
  /// Spotify calls use the token on the JWT session. Nullable so the row can be
  /// recreated from session identity alone if it goes missing (see lib/current-user.ts).
  accessToken        String?
  accessTokenExpires DateTime?
  refreshTokenEnc    String?
  /// Set when a full liked-songs sync (see LikedTrack) last completed successfully.
  likedTracksSyncedAt DateTime?
  createdAt          DateTime @default(now())

  collections Collection[]
  tags        Tag[]
  likedTracks LikedTrack[]
}

/// A user-defined "folder" grouping saved tracks and/or playlists by Spotify ID,
/// since the Spotify Web API does not expose real playlist folders.
model Collection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String?
  icon        String?
  /// Spotify playlist this collection was last exported to. Set by the export
  /// route so re-exporting updates that playlist instead of creating duplicates.
  /// Cleared when Spotify reports the playlist as deleted (404 on update).
  spotifyPlaylistId String?
  exportedAt        DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trackItems        CollectionTrack[]
  playlistItems     CollectionPlaylist[]
  /// Present iff this is a "smart" collection: membership is computed from the rule
  /// instead of stored as CollectionTrack rows. Its presence *is* the smart flag —
  /// there is deliberately no separate boolean that could disagree with it.
  smartPlaylistRule SmartPlaylistRule?

  @@index([userId])
}

/// A lightweight many-to-many label a track can carry, independent of any Collection.
model Tag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  createdAt DateTime @default(now())

  trackTags  TrackTag[]
  smartRules SmartPlaylistRule[]

  @@unique([userId, name])
}

/// Denormalized track display fields (name/artists/albumImage/durationMs/spotifyUrl) are
/// snapshotted here at add-time instead of being re-fetched from Spotify by ID, because
/// Spotify's Get Track(s) catalog endpoint (GET /tracks) returns 403 for apps in
/// Development Mode without Extended Quota access (confirmed 2026-07-28). This deviates
/// from the original "never mirror Spotify data" design, but that endpoint isn't usable.
model CollectionTrack {
  id             String     @id @default(cuid())
  collectionId   String
  collection     Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  spotifyTrackId String
  trackName      String
  trackArtists   String
  albumImage     String?
  durationMs     Int
  spotifyUrl     String
  addedAt        DateTime   @default(now())
  position       Int?

  @@unique([collectionId, spotifyTrackId])
}

model CollectionPlaylist {
  id                String     @id @default(cuid())
  collectionId      String
  collection        Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  spotifyPlaylistId String
  addedAt           DateTime   @default(now())

  @@unique([collectionId, spotifyPlaylistId])
}

model TrackTag {
  id             String   @id @default(cuid())
  tagId          String
  tag            Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  spotifyTrackId String
  addedAt        DateTime @default(now())

  @@unique([tagId, spotifyTrackId])
}

/// User-defined rule for an auto-updating "smart" collection: today, "every liked track
/// carrying this tag". Membership is computed live at read time, never stored.
///
/// The tag is a real foreign key rather than an id inside a JSON blob so the database can
/// enforce it: deleting the tag cascades the rule away, and the collection degrades into an
/// ordinary empty collection instead of pointing at something that no longer exists.
model SmartPlaylistRule {
  id           String     @id @default(cuid())
  collectionId String     @unique
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  tagId        String
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  lastRunAt    DateTime?

  @@index([tagId])
}

/// Local cache of the user's Spotify "liked songs" (GET /me/tracks), reconciled by a full
/// sync run (app/api/spotify/library/sync). Denormalized for the same reason as CollectionTrack
/// (see comment above) — but this is a full cache, not a snapshot-on-add: every sync upserts
/// touched rows and sweeps any row whose syncedAt predates that run (i.e. no longer liked).
model LikedTrack {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spotifyTrackId String
  trackName      String
  trackArtists   String
  /// Unicode-lowercased copies of the two searchable fields. SQLite's LIKE and lower() only
  /// fold ASCII, so "KAŽU" would not match "Kažu" without them; search lowercases the query
  /// in JS and compares against these instead.
  trackNameLower    String
  trackArtistsLower String
  albumName      String
  albumImage     String?
  durationMs     Int
  spotifyUrl     String
  addedAt        DateTime
  syncedAt       DateTime @default(now()) @updatedAt

  @@unique([userId, spotifyTrackId])
  @@index([userId, trackNameLower])
  @@index([userId, trackArtistsLower])
}
